{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
