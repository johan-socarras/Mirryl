<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- asInvoker on purpose: the app itself needs no special rights (adb,
             mirroring, pairing and the registry all run fine as a normal user).
             Only two things need administrator - the Windows Firewall rules and
             registering the auto-reconnect scheduled task - and Windows decides
             elevation once, at process launch, so demanding admin here would
             mean a UAC prompt on EVERY start just for those two. They elevate on
             demand instead (run_powershell_elevated in main.rs), so the prompt
             appears only when something actually has to be repaired.

             Keep this file free of the other level's literal name: grepping the
             shipped exe for it is how you verify what got embedded, and a
             mention in a comment reads as a false positive. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
      <dpiAware>true/pm</dpiAware>
    </asmv3:windowsSettings>
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <dpiAwareness>PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
