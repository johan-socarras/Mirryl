<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Starting-window theme. Follows the system for the launch frame only; each
      Activity then calls Theme.platformTheme() to honour the user's saved choice.
      No action bar: the screens draw their own title.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
